# --- Required ---

# Neon pooled connection string. Starts with postgresql://
DATABASE_URL=

# Login password. Any string you choose.
DASHBOARD_PASSWORD=

# Random string to protect cron endpoints. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- API keys ---

# https://helius.dev — free tier
HELIUS_API_KEY=

# https://birdeye.so — free tier (some endpoints gated)
BIRDEYE_API_KEY=

# https://lunarcrush.com — free tier (check #5 may return UNKNOWN)
LUNARCRUSH_API_KEY=
